{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Preserve",
		"moduleResolution": "bundler",
		"jsx": "preserve",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true
	},
	"include": ["**/*.ts", "**/*.tsx", "**/*.svelte"],
	"exclude": ["node_modules", "dist"]
}
